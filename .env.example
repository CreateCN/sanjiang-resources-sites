# 复制为 .env 后填写；docker compose 会自动读取。
# 对外访问的完整站点地址，必须与浏览器地址完全一致（协议 + 域名 [+ 端口]）。
SITE_URL=http://localhost:4321

# 是否信任反向代理写入的单值 X-Forwarded-For（决定限流是否按访客而不是按站点）。
# 仅在应用只能经由自己的代理访问时开启（compose 默认只绑定 127.0.0.1）。
# 开启后 Nginx 必须覆盖写入：proxy_set_header X-Forwarded-For $remote_addr;
TRUST_PROXY=1

# 备份目录：容器内固定为 /app/backups，对应宿主机 ./backups；保留份数默认 7。
BACKUP_HOST_DIR=./backups
BACKUP_KEEP=7

# 独立维护容器自动执行；小时/星期均为 UTC，星期 0=周日。
# 默认：北京时间每天 03:00 备份，每周一 04:00 检查链接。
BACKUP_UTC_HOUR=19
LINK_CHECK_UTC_HOUR=20
LINK_CHECK_UTC_DAY=0
# 北京时间每天02:00清理超过90天的匿名统计。
METRICS_CLEANUP_UTC_HOUR=18

# 数据库路径：容器内固定使用 /app/data/site.sqlite（挂载持久卷）。
# 本地开发不设置时默认为 ./data/site.sqlite。
# DATABASE_PATH=./data/site.sqlite

# Docker 构建时传入 git rev-parse HEAD；普通 npm 构建自动读取 Git。
# COMMIT_SHA=完整的40位提交哈希
