# 复制为 .env 后填写；docker compose 会自动读取。
# 对外访问的完整站点地址，必须与浏览器地址完全一致（协议 + 域名 [+ 端口]）。
SITE_URL=http://localhost:4321

# ── 新库初始化 ─────────────────────────────────────────────────────────────
# 只对尚无初始化标记的新库生效：empty=空站（一个综合分类）；demo=2 条通用示例。
# 已有实例只迁移，不转换模式；如需切换模式必须自行备份后重建实例。
SITE_INIT_MODE=empty
# 新实例的初始名称，同时冻结为 TOTP issuer；之后可在后台改品牌，issuer 不变。
SITE_INIT_NAME=三匠资源站

# 是否信任反向代理写入的单值 X-Forwarded-For（决定限流是否按访客而不是按站点）。
# 仅在应用只能经由自己的代理访问时开启（compose 默认只绑定 127.0.0.1）。
# 开启后 Nginx 必须覆盖写入：proxy_set_header X-Forwarded-For $remote_addr;
TRUST_PROXY=1

# 代理共享凭据：应用据此确认"这个转发头确实来自我们的代理"，而不是客户端自己写的。
# 长度至少 16（建议 32 位随机值）；未配置时 TRUST_PROXY=1 会 fail closed：
# 所有请求按不可信身份处理，只吃站点级限流（登录 500/5 分钟、反馈 500/小时）。
# 代理侧必须写入同名头，并覆盖写入单值 X-Forwarded-For：
#   proxy_set_header X-Sanjiang-Proxy-Secret "<与这里相同的值>";
#   proxy_set_header X-Forwarded-For $remote_addr;
# 接入 CDN 时不要改这里：在 Nginx 用 set_real_ip_from + real_ip_header 还原 $remote_addr。
TRUST_PROXY_SECRET=

# 备份目录：容器内固定为 /app/backups，对应宿主机 ./backups；保留份数默认 7。
BACKUP_HOST_DIR=./backups
BACKUP_KEEP=7

# 独立维护容器自动执行；小时/星期均为 UTC，星期 0=周日。
# 默认：北京时间每天 03:00 备份，每周一 04:00 检查链接。
BACKUP_UTC_HOUR=19
LINK_CHECK_UTC_HOUR=20
LINK_CHECK_UTC_DAY=0
# 北京时间每天02:00清理超过90天的匿名统计。
METRICS_CLEANUP_UTC_HOUR=18

# ── 双因素认证（TOTP）──────────────────────────────────────────────────────
# 32 字节 base64url 随机密钥，用于加密每个账户的 TOTP 秘密。
# 生成：node -e "console.log('TOTP_ENC_KEY=' + require('node:crypto').randomBytes(32).toString('base64url'))"
# 必须与数据库分开备份：只恢复数据库而丢失本密钥，所有账户都无法用 TOTP 登录，只能走 totp:reset。
# 未设置时公开站不受影响，但双因素启用/验证会 fail-closed（不会降级为口令登录）。
TOTP_ENC_KEY=
# off | admin | admin,editor。切换前必须先离线运行 npm run totp:policy -- --from <旧> --to <新> --yes，
# 再改本值并重启；只改环境变量不会让旧会话/旧挑战失效。
TOTP_REQUIRED_FOR=off

# ── 媒体（图片上传）────────────────────────────────────────────────────────
# 容器内固定 /app/data/media（与数据库同卷）。备份必须使用 npm run site:backup。
MEDIA_DIR=/app/data/media
# 媒体总预算（含下架文件与未结算预留），默认 512 MiB。
MEDIA_QUOTA_BYTES=536870912
# 落盘时必须保留的磁盘余量，默认 128 MiB。
MEDIA_MIN_FREE_BYTES=134217728

# 数据库路径：容器内固定使用 /app/data/site.sqlite（挂载持久卷）。
# 本地开发不设置时默认为 ./data/site.sqlite。
# DATABASE_PATH=./data/site.sqlite

# Docker 构建时传入 git rev-parse HEAD；普通 npm 构建自动读取 Git。
# COMMIT_SHA=完整的40位提交哈希
