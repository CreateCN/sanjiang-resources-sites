{
  "name": "sanjiang-resources",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "author": "CreateCN",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CreateCN/sanjiang-resources-sites.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 0.0.0.0",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 0.0.0.0",
    "start": "node ./dist/server/entry.mjs",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "db:admin": "node scripts/create-admin.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node --test tests/browser.mjs",
    "test:admin": "node --test tests/admin-e2e.mjs",
    "test:server": "node --test tests/server.test.mjs",
    "db:backup": "node scripts/backup-db.mjs",
    "db:restore": "node scripts/restore-db.mjs",
    "links:check": "node scripts/check-links.mjs",
    "images:build": "node scripts/optimize-images.mjs",
    "predev": "npm run images:build",
    "prebuild": "npm run images:build",
    "precheck": "npm run images:build",
    "pretest": "npm run images:build",
    "maintenance": "node scripts/maintenance.mjs",
    "metrics:clean": "node scripts/cleanup-metrics.mjs",
    "totp:reset": "node scripts/reset-totp.mjs",
    "totp:policy": "node scripts/set-totp-policy.mjs",
    "media:reconcile": "node scripts/reconcile-media.mjs",
    "site:backup": "node scripts/backup-site.mjs",
    "site:restore": "node scripts/restore-site.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^9.5.5",
    "astro": "^5.0.0",
    "markdown-it": "^14.3.3",
    "qrcode": "1.5.4",
    "sharp": "0.34.5",
    "undici": "^8.12.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@playwright/test": "^1.56.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.2",
    "@types/qrcode": "1.5.6",
    "jsqr": "1.4.0",
    "typescript": "^5.7.0"
  }
}
