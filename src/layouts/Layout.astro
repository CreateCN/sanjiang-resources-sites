---
import '../styles/site.css';
import CommitVersion from '../components/CommitVersion.astro';
import { UPSTREAM, deriveThemeTokens } from '../lib/site-config';
import { getPublicSiteConfig, getBrandAssets, getSiteOrigin } from '../server/site-config';
import { isDemoContent } from '../server/demo';
interface Props { title: string; description?: string; type?: 'website' | 'article'; jsonLd?: Record<string, unknown>[]; noindex?: boolean; }
const site = getPublicSiteConfig();
const assets = getBrandAssets();
const theme = deriveThemeTokens(site.accentColor);
const { title, description = site.description, type = 'website', jsonLd = [], noindex = false } = Astro.props;
const year = new Date().getFullYear();
const path = Astro.url.pathname;
const origin = getSiteOrigin(Astro.url);
const canonical = `${origin}${path}`;
const shareImage = `${origin}${assets.shareImageUrl}`;
const brandMark = [...site.name.trim()][0] ?? '书';
const licenseUrl = `${UPSTREAM.repository}/blob/master/LICENSE`;
// 只写入服务端计算出的 #RRGGBB；部署者不能注入原始 CSS。
const themeStyle = `--portal-green:${theme.accent};--portal-green-dark:${theme.accentHover};--portal-soft:${theme.soft};--portal-softest:${theme.softest};--portal-paper:${theme.paper}`;
const nav = [
  { href: '/#catalog', name: '资源目录', match: '/' },
  { href: '/guides/', name: '使用指南', match: '/guides/' },
  { href: '/about/', name: '收录说明', match: '/about/' },
  { href: '/feedback/', name: '反馈与推荐', match: '/feedback/' },
];
const safeJson = (value: unknown) => JSON.stringify(value).replaceAll('<', '\\u003c');
const footerOwner = site.organizationName || '本实例维护者';
const demo = isDemoContent();
---
<!doctype html>
<html lang="zh-CN" style={themeStyle}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={site.accentColor} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={`${title} · ${site.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} · ${site.name}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <link rel="icon" type={assets.faviconType} href={assets.faviconUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title} · {site.name}</title>
    {jsonLd.length > 0 && <script type="application/ld+json" set:html={safeJson(jsonLd.length === 1 ? jsonLd[0] : jsonLd)} />}
  </head>
  <body>
    <a class="portal-skip" href="#main">跳到主要内容</a>
    {demo && <div class="portal-demo-banner" role="status">演示内容，请替换并重新核验后再对外发布。</div>}
    <header class="portal-header portal-container">
      <a class="portal-brand" href="/" aria-label={`${site.name}首页`}>
        {assets.logoUrl
          ? <img class="portal-brand-logo" src={assets.logoUrl} alt="" />
          : <span class="portal-brand-mark" aria-hidden="true">{brandMark}</span>}
        <span><strong>{site.name}</strong>{site.subtitle && <span>{site.subtitle}</span>}</span>
      </a>
      <nav aria-label="主要导航">
        {nav.map((item) => <a class:list={[{ current: item.match === '/' ? path === '/' : path.startsWith(item.match) }]} href={item.href} aria-current={(item.match === '/' ? path === '/' : path.startsWith(item.match)) ? 'page' : undefined}>{item.name}</a>)}
        <a class="portal-admin" href="/admin/">管理入口 <span aria-hidden="true">↗</span></a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="portal-footer">
      <div class="portal-container">
        <div class="portal-footer-main">
          <div><strong>{site.name}</strong><p>{site.footerText}</p></div>
          <nav aria-label="页脚导航"><a href="/guides/">使用指南</a><a href="/updates/">处理记录</a><a href="/about/">收录说明</a><a href="/feedback/">反馈与推荐</a><a href="/admin/">管理入口</a></nav>
        </div>
        <div class="portal-footer-note">
          <p>{site.nonOfficialStatement}</p>
          <p>资源条件以提供方最新说明为准；核验状态不等于实际使用测试。</p>
          {site.showProjectAttribution && <p>本实例基于 <a href={UPSTREAM.repository} target="_blank" rel="noopener noreferrer">{UPSTREAM.name}</a> 构建 · <CommitVersion /></p>}
          <p class="portal-footer-legal">© {year} {footerOwner} · {site.showProjectAttribution
            ? <a href={licenseUrl} target="_blank" rel="noopener noreferrer">MIT 协议</a>
            : '程序代码以 MIT 协议开源（许可文本随发行物提供）'} · 资源说明与截图版权归原提供方</p>
        </div>
      </div>
    </footer>
    <script>
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          for (const entry of entries) if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); }
        }, { threshold: 0.06 });
        document.querySelectorAll('[data-reveal]').forEach((element) => observer.observe(element));
      }
      // 匿名聚合外跳计数；失败绝不影响导航。
      document.addEventListener('click', (event) => {
        const link = (event.target as Element | null)?.closest<HTMLAnchorElement>('a[data-outbound]');
        if (!link) return;
        const body = JSON.stringify({ name: 'outbound_click', target: link.dataset.outbound });
        try {
          if (navigator.sendBeacon) navigator.sendBeacon('/api/event/', new Blob([body], { type: 'application/json' }));
          else fetch('/api/event/', { method: 'POST', body, headers: { 'Content-Type': 'application/json' }, keepalive: true }).catch(() => {});
        } catch { /* ignore */ }
      });
    </script>
  </body>
</html>
