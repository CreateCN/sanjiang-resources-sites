---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getSession } from '../../server/auth';
import { getPublishedResources, listManagedResources, listReports, listCategories, metricsSummary } from '../../server/store';
import { pendingDrafts } from '../../lib/notices';
import { freshness } from '../../lib/freshness';
import { formatRevisionTime } from '../../lib/revision-fields';
const session = getSession(Astro.request);
if (!session) return Astro.redirect('/admin/login/');
const resources = listManagedResources();
const reports = listReports();
const metrics = metricsSummary(30);
const overdue = resources.filter((entry) => freshness(entry.draft).overdue).length;
const pending = pendingDrafts();
const draftHref = (entry: { kind: 'resource' | 'guide'; id: string }) => entry.kind === 'guide' ? `/admin/guides/${encodeURIComponent(entry.id)}/` : `/admin/resources/${encodeURIComponent(entry.id)}/`;
const waitTime = (updatedAt: string) => {
  const days = Math.floor((Date.now() - Date.parse(updatedAt)) / 86400000);
  return days <= 0 ? '今天更新' : `等待 ${days} 天`;
};
// 资源区分：从未发布 / 已发布但有未发布改动 / 已停用——三者对管理员的意义不同。
const stateOf = (r: (typeof resources)[number]) => r.lifecycle.discontinuedAt
  ? (r.published ? '保留解释页' : '无公开快照')
  : !r.published ? '新草稿' : JSON.stringify(r.published) !== JSON.stringify(r.draft) ? '有未发布修改' : '与公开版本一致';
---
<AdminLayout title="工作概览" session={session}>
  <div class="stats"><div class="stat">全部资源<strong>{resources.length}</strong></div><div class="stat">目录展示<strong>{getPublishedResources().length}</strong></div><div class="stat">公开快照<strong>{resources.filter((r) => r.published).length}</strong></div><div class="stat">待发布<strong>{pending.length}</strong></div><div class="stat">待复核<strong>{overdue}</strong></div><div class="stat">反馈处理中<strong>{reports.filter((r) => r.status !== 'resolved').length}</strong></div><div class="stat">近 30 天外跳<strong>{metrics.totals.outbound_click ?? 0}</strong></div><div class="stat">学习场景<strong>{listCategories().length}</strong></div></div>
  <section class="notice"><h2>先整理，再发布。</h2><p>{session.user.role === 'admin' ? '编辑者的保存只更新草稿。请核对费用、资格和来源后，由管理员明确发布；撤回后前台不再展示。' : '你可以创建和修改资源草稿、处理学生反馈。发布、撤回、删除以及人员管理需要管理员操作。'}</p></section>
  <section class="panel" id="pending-drafts"><h2>待发布草稿（{pending.length}）</h2>
    {pending.length === 0
      ? <p class="empty">没有等待发布的草稿。编辑者保存后，条目会出现在这里。</p>
      : <div class="table-wrap"><table><thead><tr><th>条目</th><th>类型</th><th>状态</th><th>更新时间</th></tr></thead><tbody>
          {pending.slice(0, 10).map((entry) => <tr><td><a href={draftHref(entry)}>{entry.title}</a></td><td>{entry.kind === 'guide' ? '指南' : '资源'}</td><td>{entry.isNew ? '新草稿' : '有未发布修改'}</td><td>{formatRevisionTime(entry.updatedAt)}<br/><span class="muted">{waitTime(entry.updatedAt)}</span></td></tr>)}
        </tbody></table></div>}
    {pending.length > 0 && <p class="muted">{session.user.role === 'admin' ? '发布是管理员动作；发布后条目会从这里消失。' : '你保存的草稿会出现在这里，等管理员发布。'}{pending.length > 10 ? ` 仅显示最近 10 条，共 ${pending.length} 条。` : ''}</p>}
  </section>
  <section class="panel"><h2>从这里继续</h2><div class="actions"><a class="button" href="/admin/resources/new/">新增资源草稿</a><a class="button secondary" href="/admin/resources/">管理资源</a><a class="button secondary" href="/admin/reports/">处理反馈</a><a class="button secondary" href="/admin/reviews/">复核过期资料</a></div></section>
  <section class="panel"><h2>最近修改的资源</h2><div class="table-wrap"><table><thead><tr><th>资源</th><th>发布状态</th><th>更新时间</th></tr></thead><tbody>{resources.slice(0,6).map((r) => <tr><td><a href={`/admin/resources/${r.id}/`}>{r.draft.title}</a></td><td>{r.lifecycle.discontinuedAt ? `已停用 · ${stateOf(r)}` : r.published ? `已发布 · ${stateOf(r)}` : '未发布'}</td><td>{r.updatedAt}</td></tr>)}</tbody></table></div></section>
</AdminLayout>
