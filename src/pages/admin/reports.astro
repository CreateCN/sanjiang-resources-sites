---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getSession } from '../../server/auth';
import { listReports, listRevisions } from '../../server/store';
import { ACTION_LABELS, formatRevisionTime } from '../../lib/revision-fields';
const session = getSession(Astro.request);
if (!session) return Astro.redirect('/admin/login/');
const reports = listReports();
const statusNames: Record<string, string> = { new: '待处理', processing: '处理中', resolved: '已解决' };
---
<AdminLayout title="反馈处理" session={session}>
  <p class="notice">来自站内的匿名反馈仅供授权维护者查看。状态与备注不会自动公开，也不会自动修改资源核验结果；“关联修订”只记录这次处理对应哪次内容修改，便于以后追溯。</p>
  {reports.length === 0 && <section class="panel empty"><h2>暂时没有反馈</h2><p>学生提交的问题会出现在这里。</p></section>}
  {reports.map((report) => {
    const revisions = report.resourceId ? listRevisions('resource', report.resourceId, 20) : [];
    const linked = report.revisionId ? revisions.find((revision) => revision.id === report.revisionId) : undefined;
    return <article class="report"><header><h2>{report.title}</h2><span class="badge">{statusNames[report.status]}</span></header><p class="report-meta">{report.kind} · {report.resourceId ?? '其他或新资源'} · {formatRevisionTime(report.createdAt)}</p><div class="report-body">{report.body}</div>{linked && <p class="report-meta">已关联修订：v{linked.version} · {ACTION_LABELS[linked.action] ?? linked.action} · {formatRevisionTime(linked.createdAt)}</p>}<form action="/api/manage/" method="post" data-admin-form><input type="hidden" name="csrf" value={session.csrfToken}/><input type="hidden" name="action" value="update-report"/><input type="hidden" name="id" value={report.id}/><div class="form-grid"><div class="field"><label for={`status-${report.id}`}>处理状态</label><select id={`status-${report.id}`} name="status">{[{ id: 'new', name: '待处理' }, { id: 'processing', name: '处理中' }, { id: 'resolved', name: '已解决' }].map((status) => <option value={status.id} selected={report.status === status.id}>{status.name}</option>)}</select></div>{report.resourceId && <div class="field"><label for={`revision-${report.id}`}>关联修订（可选）</label><select id={`revision-${report.id}`} name="revisionId"><option value="">不关联</option>{revisions.map((revision) => <option value={revision.id} selected={report.revisionId === revision.id}>v{revision.version} · {ACTION_LABELS[revision.action] ?? revision.action} · {formatRevisionTime(revision.createdAt)}</option>)}</select><small>选择处理这条反馈时保存的草稿版本。</small></div>}<div class="field full"><label for={`note-${report.id}`}>内部处理备注</label><textarea id={`note-${report.id}`} name="note" maxlength="4000">{report.note}</textarea></div></div><div class="actions"><button type="submit">保存处理结果</button>{report.resourceId && <a href={`/admin/resources/${report.resourceId}/`}>检查资源草稿</a>}</div><p role="status" aria-live="polite"></p></form></article>;
  })}
</AdminLayout>
