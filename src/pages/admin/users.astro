---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getSession } from '../../server/auth';
import { listUsers } from '../../server/store';
const session = getSession(Astro.request);
if (!session) return Astro.redirect('/admin/login/');
if (session.user.role !== 'admin') return Astro.redirect('/admin/');
const users = listUsers();
---
<AdminLayout title="人员与权限" session={session}>
  <div class="notice"><strong>按职责分配权限。</strong><p>管理员：发布、撤回、删除、分类、人员与审计。编辑者：编辑草稿、处理反馈。重置密码、停用或改变角色后，该账户已有会话立即失效；不能停用或降级最后一位有效管理员。</p></div>
  <section class="panel"><h2>创建协作账户</h2><form action="/api/manage/" method="post" data-admin-form><input type="hidden" name="csrf" value={session.csrfToken}/><input type="hidden" name="action" value="create-user"/><div class="form-grid"><div class="field"><label for="new-username">用户名</label><input id="new-username" name="username" autocomplete="off" pattern="[-A-Za-z0-9_.]{3,64}" minlength="3" maxlength="64" required/><small>3–64 位英文字母、数字、下划线、点或连字符。</small></div><div class="field"><label for="new-password">初始密码</label><input id="new-password" name="password" type="password" autocomplete="new-password" minlength="12" maxlength="256" required/><small>至少 12 个字符，通过安全渠道交付，不要放入公开文档。</small></div><div class="field"><label for="new-role">角色</label><select id="new-role" name="role"><option value="editor">内容编辑者</option><option value="admin">管理员</option></select></div></div><div class="actions"><button type="submit">创建账户</button></div><p role="status" aria-live="polite"></p></form></section>
  {users.map((user) => <section class="panel"><h2>{user.username} {user.id === session.user.id ? '（当前账户）' : ''}</h2><form action="/api/manage/" method="post" data-admin-form data-confirm="确认变更账户？密码、状态或角色变化会撤销该账户的现有登录。"><input type="hidden" name="csrf" value={session.csrfToken}/><input type="hidden" name="action" value="update-user"/><input type="hidden" name="id" value={user.id}/><div class="form-grid"><div class="field"><label for={`role-${user.id}`}>角色</label><select id={`role-${user.id}`} name="role"><option value="editor" selected={user.role === 'editor'}>内容编辑者</option><option value="admin" selected={user.role === 'admin'}>管理员</option></select></div><div class="field"><label for={`password-${user.id}`}>重置密码（留空不修改）</label><input id={`password-${user.id}`} name="password" type="password" autocomplete="new-password" minlength="12" maxlength="256"/></div><label class="checkbox"><input type="checkbox" name="active" value="true" checked={user.active}/>账户有效</label></div><div class="actions"><button type="submit">保存账户设置</button></div><p role="status" aria-live="polite"></p></form></section>)}
</AdminLayout>
