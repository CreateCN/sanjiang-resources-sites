---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getSession } from '../../server/auth';
import { listManagedResources } from '../../server/store';
import { freshness, REVIEW_DAYS } from '../../lib/freshness';
const session = getSession(Astro.request);
if (!session) return Astro.redirect('/admin/login/');
const today = new Date();
const todayValue = today.toISOString().slice(0, 10);
const rows = listManagedResources().map((entry) => ({ entry, state: freshness(entry.draft, today) }))
  .sort((a, b) => {
    if (a.state.overdue !== b.state.overdue) return a.state.overdue ? -1 : 1;
    const left = a.state.dueAt?.getTime() ?? 0;
    const right = b.state.dueAt?.getTime() ?? 0;
    return left - right;
  });
const overdue = rows.filter((row) => row.state.overdue);
const soon = rows.filter((row) => !row.state.overdue && (row.state.daysUntilDue ?? 999) <= 30);
const label = (value: number) => `${value > 0 ? '还有' : '逾期'} ${Math.abs(value)} 天`;
---
<AdminLayout title="复核队列" session={session}>
  <div class="notice"><strong>目录类产品的最大风险是信息过期，而不是功能太少。</strong><p>已核对条目按资源类型到期：开源工具与公开课程 180 天，学生权益 90 天；资料待核对条目立即出现在队列。核对完成后仍走“保存草稿 → 发布”，不要绕过发布快照。</p></div>
  <div class="stats"><div class="stat">待核对<strong>{rows.filter((row) => row.entry.draft.status !== 'verified').length}</strong></div><div class="stat">已逾期<strong>{overdue.length}</strong></div><div class="stat">30 天内到期<strong>{soon.length}</strong></div><div class="stat">全部资源<strong>{rows.length}</strong></div></div>
  <form class="panel" id="bulk-review" action="/api/manage/" method="post" data-admin-form><input type="hidden" name="csrf" value={session.csrfToken}/><input type="hidden" name="action" value="bulk-review"/><div class="actions" style="margin:0"><strong>批量复核</strong><label class="muted" for="bulk-date">核对日期</label><input id="bulk-date" type="date" name="date" value={todayValue} style="max-width:170px"/><button type="submit" name="status" value="verified">批量标记已核对</button><button type="submit" name="status" value="review" class="secondary">批量标记待核对</button><span class="muted">勾选下方资源后提交；会写入版本历史。</span></div><p role="status" aria-live="polite"></p></form>
  <div class="table-wrap"><table><thead><tr><th>选择</th><th>资源</th><th>核验状态</th><th>核对日期</th><th>到期情况</th><th>操作</th></tr></thead><tbody>{rows.map(({ entry, state }) => <tr><td><input type="checkbox" name="ids" value={entry.id} form="bulk-review" aria-label={`选择 ${entry.draft.title}`}/></td><td><strong>{entry.draft.title}</strong><br/><span class="muted">{entry.draft.kind} · 周期 {REVIEW_DAYS[entry.draft.kind]} 天</span></td><td><span class:list={['badge', { published: entry.draft.status === 'verified' }]}>{entry.draft.status === 'verified' ? '官方信息已核对' : '资料待核对'}</span>{entry.published && <p class="muted">前台公开版本：{entry.published.status === 'verified' ? '已核对' : '待核对'}</p>}</td><td>{entry.draft.checkedAt ?? '—'}</td><td>{state.overdue ? <span class="error" style="padding:0;background:none">{entry.draft.status === 'verified' ? (state.daysUntilDue !== null ? label(state.daysUntilDue) : '需要复核') : '尚未核对'}</span> : (state.daysUntilDue !== null ? label(state.daysUntilDue) : '—')}</td><td><a href={`/admin/resources/${entry.id}/`}>去核对</a>{entry.published && <p><a href={`/resources/${entry.id}/`} target="_blank" rel="noopener noreferrer">查看前台 ↗</a></p>}</td></tr>)}</tbody></table>{rows.length === 0 && <p class="empty">还没有资源。</p>}</div>
</AdminLayout>
