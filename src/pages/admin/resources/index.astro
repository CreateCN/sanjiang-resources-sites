---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getSession } from '../../../server/auth';
import { linkCheckStaleReason, listLinkChecks, listManagedResources } from '../../../server/store';
import { accessLabel } from '../../../lib/access';
const session = getSession(Astro.request);
if (!session) return Astro.redirect('/admin/login/');
const resources = listManagedResources();
const checks = new Map(listLinkChecks().map((check) => [check.resourceId, check]));
// 与详情页共用过期判断：列表显示“可访问”、详情显示“需重新检查”会让维护者判断出错。
const labels: Record<string, string> = { ok: '可访问', warn: '需人工确认', broken: '可能失效', error: '检查失败' };
---
<AdminLayout title="资源管理" session={session}>
  <div class="toolbar"><label for="resource-filter" class="muted">按名称或 ID 查找 <input id="resource-filter" type="search" placeholder="输入名称、ID 或场景"/></label><div class="actions" style="margin:0"><a class="button" href="/admin/resources/new/">新增资源草稿</a><a class="button secondary" href="/admin/trash/">回收站</a></div></div>
  <div class="table-wrap"><table><thead><tr><th>资源名称</th><th>场景</th><th>发布状态</th><th>资料核验</th><th>使用门槛</th><th>链接检查</th><th>操作</th></tr></thead><tbody>{resources.map((r) => <tr data-search={`${r.id} ${r.draft.title} ${r.draft.category}`}><td><strong>{r.draft.title}</strong><br/><span class="muted">{r.id} · v{r.version}</span></td><td>{r.draft.category}</td><td>{r.lifecycle.discontinuedAt ? <><span class="badge">已停用</span><p class="muted">{r.published ? '保留解释页' : '无公开快照'}</p></> : <span class:list={['badge',{published:!!r.published}]}>{r.published ? '已公开' : '草稿'}</span>}{r.published && JSON.stringify(r.published) !== JSON.stringify(r.draft) && <p class="muted">有未发布修改</p>}</td><td>{r.draft.status === 'verified' ? '官方信息已核对' : '待核对'}</td><td>{accessLabel(r.draft.access)}</td><td>{(() => { const check = checks.get(r.id); if (!check) return <span class="muted">未检查</span>; const reason = linkCheckStaleReason(check, r); return <>{labels[check.status] ?? check.status}{reason && <><br/><span class="badge">需重新检查</span></>}<br/><span class="muted">{check.checkedAt.slice(0, 10)} · {check.scope === 'published' ? '公开版本' : '草稿'}</span></>; })()}<form action="/api/manage/" method="post" data-admin-form style="margin-top:6px"><input type="hidden" name="csrf" value={session.csrfToken}/><input type="hidden" name="action" value="check-link"/><input type="hidden" name="id" value={r.id}/><button type="submit" class="secondary" style="min-height:32px;padding:4px 8px;font-size:13px">检查链接</button><p role="status" aria-live="polite"></p></form></td><td><a href={`/admin/resources/${r.id}/`}>编辑详情</a>{r.published && <p><a href={`/resources/${r.id}/`} target="_blank" rel="noopener noreferrer">{r.lifecycle.discontinuedAt ? '查看解释页' : '查看前台'} ↗</a></p>}</td></tr>)}</tbody></table>{resources.length === 0 && <p class="empty">尚无资源，可以创建第一份草稿。</p>}</div><p id="admin-status" role="status" aria-live="polite"></p>
</AdminLayout>
<script>
  document.querySelector<HTMLInputElement>('#resource-filter')?.addEventListener('input', (event) => { const q = (event.target as HTMLInputElement).value.trim().toLowerCase(); document.querySelectorAll<HTMLTableRowElement>('tr[data-search]').forEach((row) => row.hidden = !(row.dataset.search ?? '').toLowerCase().includes(q)); });
</script>
