---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getSession } from '../../../server/auth';
import { findManagedResource, linkCheckStaleReason, listCategories, listLinkChecks, listRevisions } from '../../../server/store';
import { ACCESS_OPTIONS } from '../../../lib/access';
import { formatRevisionTime } from '../../../lib/revision-fields';
import DraftRecovery from '../../../components/DraftRecovery.astro';
import RevisionHistory from '../../../components/RevisionHistory.astro';
const session = getSession(Astro.request);
if (!session) return Astro.redirect('/admin/login/');
const isNew = Astro.params.id === 'new';
const entry = isNew ? undefined : findManagedResource(Astro.params.id ?? '');
if (!isNew && !entry) return Astro.redirect('/admin/resources/');
if (entry?.deletedAt) return Astro.redirect('/admin/trash/');
const linkCheck = entry ? listLinkChecks().find((check) => check.resourceId === entry.id) : undefined;
// 检查结果绑定的是「当时那个 URL + 那个版本 + 检查对象（草稿/公开快照）」；
// 目标变了就不再代表当前内容，过期判断与资源列表共用同一个函数。
const linkCheckReason = linkCheck && entry ? linkCheckStaleReason(linkCheck, entry) : null;
const checkLabels: Record<string, string> = { ok: '可访问', warn: '需人工确认', broken: '可能失效', error: '检查失败' };
const categories = listCategories();
const resource = entry?.draft ?? {id:'',title:'',summary:'',category:categories[0]?.id ?? '',kind:'开源工具',cost:'',platforms:['网页'],tags:[],url:'',sourceUrl:'',license:'',eligibility:'',caveat:'',steps:[''],status:'review',checkedAt:null,imageRights:'unconfirmed'};
interface EditorField { key: string; name: string; help?: string; area?: boolean; optional?: boolean; type?: 'text' | 'url'; max?: number }
const fields: EditorField[] = [
  {key:'id',name:'稳定 ID',help:'小写字母、数字和连字符；创建后不可更改。'}, {key:'title',name:'资源名称'},
  {key:'summary',name:'用途简介',area:true}, {key:'cost',name:'费用摘要'}, {key:'url',name:'官方访问链接',type:'url'},
  {key:'sourceUrl',name:'官方资料来源',type:'url'}, {key:'platforms',name:'支持平台',help:'用中文或英文逗号分隔，例如 Windows、macOS。'},
  {key:'tags',name:'标签',help:'用逗号分隔；发布时公开展示。'}, {key:'license',name:'许可与收费边界',area:true},
  {key:'eligibility',name:'资格与身份要求',area:true}, {key:'caveat',name:'限制与注意事项',area:true},
  {key:'steps',name:'入门步骤',area:true,help:'每行一步，不用添加序号。'},
  {key:'details',name:'详细说明（Markdown）',area:true,optional:true,max:20000,help:'可选。支持标题、列表、链接、引用、表格与代码块；原始 HTML 会被转义。' },
  {key:'image',name:'本地图片路径',help:'可空；仅支持 /images/ 下现有文件。首版不提供文件上传。',optional:true}, {key:'imageAlt',name:'图片说明',optional:true},
];
const valueOf = (key: string) => { const value = (resource as unknown as Record<string,unknown>)[key]; return Array.isArray(value) ? value.join(key === 'steps' ? '\n' : ', ') : typeof value === 'string' ? value : ''; };
---
<AdminLayout title={isNew ? '新增资源草稿' : `编辑：${resource.title}`} session={session}>
  <div class="section-links"><a href="/admin/resources/">返回资源列表</a>{entry && <a href={`/admin/preview/resources/${entry.id}/`} target="_blank" rel="noopener noreferrer">预览整页草稿 ↗</a>}{entry?.published && <a href={`/resources/${entry.id}/`} target="_blank" rel="noopener noreferrer">查看当前公开版本 ↗</a>}</div>
  <div class="notice"><strong>{entry?.published ? '当前资源已公开，本次保存仅更新草稿。' : '草稿尚未公开。'}</strong><p>只有管理员点击“发布当前草稿”，前台才会更新。{entry ? `当前编辑版本 v${entry.version}；其他人保存后，你需要重新载入，不能覆盖新版本。` : '填写完成后先保存草稿，再检查和发布。'}</p></div>
  <DraftRecovery userId={session.user.id} kind="resource" entityId={Astro.params.id ?? 'new'} />
  <form class="panel" action="/api/manage/" method="post" data-admin-form data-resource-editor>
    <input type="hidden" name="csrf" value={session.csrfToken}/><input type="hidden" name="action" value="save-resource"/><input type="hidden" name="version" value={entry?.version ?? ''}/><input type="hidden" name="resource" value={JSON.stringify(resource)}/>
    <h2>资源信息</h2><div class="form-grid">{fields.map((field) => <div class:list={['field',{full:field.area}]}><label for={`field-${field.key}`}>{field.name}{field.optional ? '（可选）' : ''}</label>{field.area ? <textarea id={`field-${field.key}`} data-field={field.key} required={!field.optional} maxlength={field.max ?? 4000}>{valueOf(field.key)}</textarea> : <input id={`field-${field.key}`} data-field={field.key} type={field.type ?? 'text'} value={valueOf(field.key)} required={!field.optional} readonly={field.key === 'id' && !isNew} maxlength={field.key === 'id' ? 100 : 1000} />}{field.help && <small>{field.help}</small>}</div>)}
      <div class="field"><label for="category">学习场景</label><select id="category" data-field="category" required>{categories.map((c) => <option value={c.id} selected={resource.category === c.id}>{c.name}</option>)}</select></div>
      <div class="field"><label for="kind">资源类型</label><select id="kind" data-field="kind">{['开源工具','免费课程','学生权益','公共资源'].map((kind) => <option selected={kind === resource.kind}>{kind}</option>)}</select></div>
      <div class="field"><label for="verification">资料核验状态</label><select id="verification" data-field="status"><option value="review" selected={resource.status === 'review'}>资料待核对</option><option value="verified" selected={resource.status === 'verified'}>官方信息已核对</option></select><small>核对资料不代表校内实测或申请必定通过。</small></div>
      <div class="field"><label for="resource-access">使用门槛</label><select id="resource-access" data-field="access">{ACCESS_OPTIONS.map((option) => <option value={option.id} selected={(resource.access ?? 'unknown') === option.id}>{option.label}</option>)}</select><small>列表与详情会显示为固定标签，帮助学生在打开前判断是否需要认证或校园网。</small></div>
      <div class="field"><label for="image-rights">图片授权状态</label><select id="image-rights" data-field="imageRights"><option value="unconfirmed" selected={resource.imageRights !== 'confirmed'}>来源未确认（侵权联系删除）</option><option value="confirmed" selected={resource.imageRights === 'confirmed'}>已确认授权</option></select><small>来源未确认的截图会在前台标注“网络图片”并提供下架入口。</small></div>
      <div class="field"><label for="image-credit">图片署名与许可</label><input id="image-credit" data-field="imageCredit" value={valueOf('imageCredit')} maxlength="300" /><small>例如：作者 / 机构，许可协议。确认授权时请填写。</small></div>
      <div class="field"><label for="checked-at">核对日期</label><input id="checked-at" data-field="checkedAt" type="date" value={resource.checkedAt ?? ''}/><small>已核对时必填；待核对时留空。</small></div>
    </div><div class="actions"><button type="button" class="secondary" id="details-preview">预览详细说明</button><span class="muted">预览不会保存。</span></div><div id="details-preview-panel" class="panel" style="display:none;background:#f7f9f5"><h3>详细说明预览</h3><div class="markdown-body" id="details-preview-body"></div></div><div class="actions"><button type="submit">保存草稿</button></div><p role="status" aria-live="polite"></p><noscript><p class="error">结构化编辑器需要启用 JavaScript 才能序列化字段，请启用后重新打开此页。未启用时请勿保存。</p></noscript>
  </form>
  {entry && <section class="panel"><h2>链接检查</h2><p>手动检查只记录结果，不会自动下架或改动发布状态；403/429 视为“需人工确认”，不当作失效。手动检查的对象是当前已保存的草稿链接。</p>{linkCheck
    ? <p>{linkCheckReason && <span class="badge">需重新检查</span>} 上次检查：{formatRevisionTime(linkCheck.checkedAt)} · <strong>{checkLabels[linkCheck.status] ?? linkCheck.status}</strong>{linkCheck.statusCode ? `（HTTP ${linkCheck.statusCode}）` : ''} · 检查对象：{linkCheck.scope === 'published' ? '公开版本' : '草稿'}{linkCheck.url && linkCheck.url !== entry.draft.url ? <><br/><span class="muted">当时检查的链接：{linkCheck.url}</span></> : ''}{linkCheck.finalUrl && linkCheck.finalUrl !== entry.draft.url ? <><br/><span class="muted">最终地址：{linkCheck.finalUrl}</span></> : ''}<br/><span class="muted">{linkCheckReason ?? linkCheck.message}</span></p>
    : <p class="muted">还没有检查记录。</p>}<form action="/api/manage/" method="post" data-admin-form><input type="hidden" name="csrf" value={session.csrfToken}/><input type="hidden" name="action" value="check-link"/><input type="hidden" name="id" value={entry.id}/><div class="actions"><button type="submit" class="secondary">现在检查链接</button><span class="muted">检查已保存的草稿链接，超时 10 秒。</span></div><p role="status" aria-live="polite"></p></form></section>}
  {entry && <RevisionHistory kind="resource" entityId={entry.id} current={entry.draft} revisions={listRevisions('resource', entry.id)} version={entry.version} csrf={session.csrfToken} categories={categories} />}
  {entry && session.user.role === 'admin' && <section class="panel"><h2>发布与下架</h2><p>以下操作只针对已保存的 v{entry.version}。未保存的表单修改不会被发布。</p><div class="actions">{['publish', ...(entry.published ? ['unpublish'] : []), 'delete-resource'].map((action) => <form action="/api/manage/" method="post" data-admin-form data-confirm={action === 'delete-resource' ? '确定把这条资源移入回收站？前台会立即隐藏，可在回收站恢复为草稿。' : action === 'unpublish' ? '确定撤回公开版本？前台将不再展示。' : '确认已经核对来源、费用与资格，并发布当前已保存草稿？'}><input type="hidden" name="csrf" value={session.csrfToken}/><input type="hidden" name="action" value={action}/><input type="hidden" name="id" value={entry.id}/><input type="hidden" name="version" value={entry.version}/><button type="submit" class:list={[{danger:action === 'delete-resource',secondary:action === 'unpublish'}]}>{action === 'publish' ? '发布当前草稿' : action === 'unpublish' ? '撤回公开版本' : '移入回收站'}</button></form>)}</div><p id="admin-status" role="status" aria-live="polite"></p></section>}
</AdminLayout>
<script>
  const form = document.querySelector<HTMLFormElement>('[data-resource-editor]');
  form?.addEventListener('submit', () => {
    const input = form.querySelector<HTMLInputElement>('input[name=resource]');
    const resource: Record<string,unknown> = {};
    for (const field of form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>('[data-field]')) {
      const key = field.dataset.field!;
      const value = field.value.trim();
      if (key === 'platforms' || key === 'tags') resource[key] = value.split(/[,，、]/).map((v) => v.trim()).filter(Boolean);
      else if (key === 'steps') resource[key] = value.split('\n').map((v) => v.trim()).filter(Boolean);
      else if (key === 'checkedAt') resource[key] = value || null;
      else if ((key === 'image' || key === 'imageAlt' || key === 'details') && !value) continue;
      else resource[key] = value;
    }
    if (resource.status === 'review') resource.checkedAt = null;
    if (input) input.value = JSON.stringify(resource);
  }, {capture:true});
  const previewButton = document.querySelector<HTMLButtonElement>('#details-preview');
  const details = document.querySelector<HTMLTextAreaElement>('[data-field="details"]');
  const panel = document.querySelector<HTMLElement>('#details-preview-panel');
  const target = document.querySelector<HTMLElement>('#details-preview-body');
  previewButton?.addEventListener('click', async () => {
    const csrf = document.querySelector<HTMLInputElement>('form[data-resource-editor] input[name=csrf]')?.value ?? '';
    const payload = new FormData();
    payload.set('csrf', csrf); payload.set('mode', 'block'); payload.set('text', details?.value ?? '');
    previewButton.disabled = true;
    try {
      const response = await fetch('/api/preview/', { method: 'POST', body: payload, headers: { Accept: 'application/json' } });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(typeof data.error === 'string' ? data.error : '预览失败');
      if (target) target.innerHTML = data.html || '<p>（没有内容）</p>';
      if (panel) panel.style.display = 'block';
    } catch (error) { if (target) target.textContent = error instanceof Error ? error.message : '预览失败'; if (panel) panel.style.display = 'block'; }
    finally { previewButton.disabled = false; }
  });
</script>
