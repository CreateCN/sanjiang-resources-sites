---
import manifest from '../data/image-variants.json';
interface Props { src: string; alt: string; sizes?: string; }
const { src, alt, sizes = '(max-width: 760px) calc(100vw - 40px), 760px' } = Astro.props;
const images = manifest as Record<string, { width: number; height: number; variants: { src: string; width: number }[] }>;
const image = images[src];
---
<picture>
  {image && <source type="image/webp" srcset={image.variants.map((variant) => `${variant.src} ${variant.width}w`).join(', ')} sizes={sizes} />}
  <img src={src} alt={alt} width={image?.width ?? 1200} height={image?.height ?? 800} loading="lazy" decoding="async" />
</picture>
