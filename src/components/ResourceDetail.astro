---
import { getPublishedResources, categoryName, getStatusLabel, feedbackUrl } from '../lib/catalog';
import { guidesForResource } from '../lib/guides';
import { renderInlineMarkdown, renderMarkdown } from '../lib/markdown';
import { freshness, freshnessNote } from '../lib/freshness';
import { accessLabel, accessHint } from '../lib/access';
import ResourceImage from './ResourceImage.astro';
interface Props { resource: import('../lib/resource-schema').Resource; preview?: boolean; }
const { resource, preview = false } = Astro.props;
const resources = getPublishedResources();
const related = resources.filter((item) => item.id !== resource.id && item.category === resource.category).slice(0, 3);
const guides = guidesForResource(resource.id);
const state = freshness(resource);
const imageUnconfirmed = Boolean(resource.image && resource.imageRights !== 'confirmed');
---
<div class="page-shell portal-container">
  <nav class="breadcrumbs" aria-label="面包屑"><a href="/">首页</a><span aria-hidden="true">/</span><a href={`/?category=${resource.category}#catalog`}>{categoryName(resource.category)}</a><span aria-hidden="true">/</span><span aria-current="page">{resource.title}</span></nav>
  <div class="detail-layout">
    <div>
      <section class="detail-head">
        <h1>{resource.title}</h1>
        <div class="detail-tags"><span>{categoryName(resource.category)}</span><span>{resource.kind}</span><span class="access-chip">{accessLabel(resource.access)}</span>{resource.tags.map((tag) => <span>{tag}</span>)}</div>
        <p class="detail-summary" set:html={renderInlineMarkdown(resource.summary)} />
      </section>
      <div class="detail-body">
        <nav class="detail-nav" aria-label="本页目录"><a href="#conditions">使用条件</a>{resource.details && <a href="#details">详细说明</a>}<a href="#start">如何开始</a><a href="#verification">核验说明</a><a href="#report">问题反馈</a></nav>
        <section id="conditions"><h2>先看看是否适合你</h2><dl class="facts"><div><dt>使用门槛</dt><dd>{accessLabel(resource.access)}：{accessHint(resource.access)}</dd></div><div><dt>费用与许可</dt><dd set:html={renderInlineMarkdown(resource.license)} /></div><div><dt>设备与平台</dt><dd>{resource.platforms.join('、')}</dd></div><div><dt>资格与身份要求</dt><dd set:html={renderInlineMarkdown(resource.eligibility)} /></div><div><dt>需要注意</dt><dd set:html={renderInlineMarkdown(resource.caveat)} /></div></dl></section>
        {resource.details && <section id="details"><h2>详细说明</h2><div class="markdown-body" set:html={renderMarkdown(resource.details)} /></section>}
        {resource.image && <figure class="screenshot"><ResourceImage src={resource.image} alt={resource.imageAlt ?? `${resource.title} 官方界面`} />
          {imageUnconfirmed && <p class="image-flag">网络图片，来源与授权未确认；如有侵权请联系管理员处理。</p>}
          <figcaption>{resource.imageCredit ?? '官方产品界面或官方网站截图'}。仅作资源识别与介绍，不代表对方背书。<a href="/about/#credits">来源说明</a>{imageUnconfirmed && <> · <a href={`/feedback/?resource=${encodeURIComponent(resource.id)}&kind=${encodeURIComponent('版权与下架')}`}>版权与下架</a></>}</figcaption></figure>}
        <section id="start"><h2>从这里开始</h2><ol class="steps">{resource.steps.map((step) => <li set:html={renderInlineMarkdown(step)} />)}</ol><a class="text-link" href={resource.url} target="_blank" rel="noopener noreferrer">打开官方页面 ↗</a></section>
        <section id="verification"><h2>我们核对了什么</h2><p>{resource.status === 'verified' ? `本条目的官方公开页面信息已于 ${resource.checkedAt} 核对，包括资源用途、公开费用或资格说明。` : '本条目尚未完成官方公开页面资料核对，页面信息仅作候选资源参考。请在官方页面确认后再决定使用。'}</p><div class="notice"><strong>资料核对，不等于实际使用保证。</strong><p>我们没有验证你的学生资格、校内网络访问或第三方申请结果。外站的费用、地区限制和服务条款可能变化，以提供方最新说明为准。</p></div><p style="margin-top:16px"><a class="text-link" href={resource.sourceUrl} target="_blank" rel="noopener noreferrer">查看官方信息来源 ↗</a></p></section>
        <section id="report"><h2>信息不对，告诉我们</h2><p>遇到链接失效、收费变化，或资格说明有误？反馈会带上当前资源名称，便于维护者定位。</p><p style="margin-top:18px"><a class="portal-button" href={feedbackUrl(resource)}>报告资源问题</a></p><p class="form-help" style="margin-top:10px">无需登录即可提交；请勿填写学号、学生证或账号凭据。</p></section>
        {guides.length > 0 && <section><h2>相关指南</h2><div class="related-list">{guides.map((guide) => <a class="related-link" href={`/guides/${guide.slug}/`}><span>{guide.title}</span><span aria-hidden="true">↗</span></a>)}</div></section>}
        {related.length > 0 && <section><h2>也可以看看</h2><div class="related-list">{related.map((item) => <a class="related-link" href={`/resources/${item.id}/`}><span>{item.title}</span><span aria-hidden="true">↗</span></a>)}</div></section>}
      </div>
    </div>
    <aside class="detail-aside" aria-label="资源摘要">
      <strong>{resource.cost}</strong>
      <p class="aside-hint">先确认下方资格与限制，再前往官方页面。</p>
      <a class="portal-button" href={resource.url} target="_blank" rel="noopener noreferrer" data-outbound={preview ? undefined : resource.id}>前往官方资源 <span aria-hidden="true">↗</span></a>
      {state.overdue && <p class="freshness-warning">资料可能已变化，点击前先确认费用与资格。</p>}
      <span class:list={['state-line', { 'is-review': resource.status === 'review' }]}>{getStatusLabel(resource)}</span>
      <p class="checked-date">{resource.checkedAt ? `公开页面核对：${resource.checkedAt}` : '未完成官方资料核对'}</p>
      <p class:list={['checked-date', { 'is-stale': state.overdue }]}>{freshnessNote(resource)}</p>
      <a class="text-link report-link" href={`/feedback/?resource=${encodeURIComponent(resource.id)}&kind=${encodeURIComponent('链接失效')}`}>报告链接打不开</a>
    </aside>
  </div>
</div>
